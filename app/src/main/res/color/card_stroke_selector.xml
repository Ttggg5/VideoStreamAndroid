<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad (Android TV) focus ring on cards: bright brand color when focused, otherwise the
     subtle glass hairline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorSecondary" android:state_focused="true" />
    <item android:color="@color/glass_stroke" />
</selector>
