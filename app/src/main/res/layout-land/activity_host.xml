<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_horizontal_margin"
    tools:context=".HostActivity">

    <!-- Landscape splits the screen into a picker column (left) and a status/action
         column (right) instead of stacking everything in one tall column. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/midGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.55" />

    <TextView
        android:id="@+id/selectedFileText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:text="@string/no_video_selected"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/midGuideline" />

    <!-- This row only has ~55% of the screen width to work with (everything left of
         midGuideline), too little for icon+text buttons at typical landscape phone widths,
         so landscape drops the labels and keeps icon-only buttons instead of risking their
         text getting clipped; contentDescription keeps them accessible. -->
    <LinearLayout
        android:id="@+id/pickerButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/selectedFileText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/midGuideline">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseFileButton"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/choose_video"
            app:icon="@drawable/ic_videocam"
            android:text="@string/choose_video" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chooseFolderButton"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/choose_folder"
            app:icon="@drawable/ic_folder"
            android:text="@string/choose_folder"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/selectedPreview"
        android:layout_width="0dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toBottomOf="@id/pickerButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/midGuideline"
        android:orientation="vertical"
        android:layout_marginTop="15dp">

        <ImageView
            android:id="@+id/thumbnailPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rounded_thumbnail"
            android:contentDescription="@string/selected_video_thumbnail"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:visibility="gone"
            tools:visibility="visible"/>

        <ImageView
            android:id="@+id/folderPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorPrimary"
            android:visibility="gone"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortOptionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/selectedPreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/midGuideline"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/option_default_sort" />

        <Spinner
            android:id="@+id/defaultSortSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:gravity="center"
        android:textSize="16sp"
        android:text="@string/status_idle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/toggleButton"
        app:layout_constraintStart_toEndOf="@id/midGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/start_streaming"
        android:textColor="@color/white"
        app:icon="@drawable/ic_play_arrow"
        app:iconTint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintBottom_toTopOf="@id/remoteControlButton"
        app:layout_constraintStart_toEndOf="@id/midGuideline"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/remoteControlButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/remote_control"
        android:visibility="gone"
        app:icon="@drawable/ic_remote"
        app:layout_constraintTop_toBottomOf="@id/toggleButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/midGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
