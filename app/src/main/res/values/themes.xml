<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark cinematic theme (the app is always dark). The active gradient theme (Settings >
         Theme) is layered on top at runtime by AppSettings.applyAccentOverlay, which sets
         colorPrimary/colorSecondary (the two gradient stops) and the matching glow colors. -->
    <style name="Theme.VideoStreamLocal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="brandGlowPrimary">#407C4DFF</item>
        <item name="brandGlowSecondary">#33FF4FA3</item>

        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:windowBackground">@drawable/bg_screen_glow</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.ExtraLarge</item>

        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ShapeAppearance.App.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">30dp</item>
    </style>
    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">36dp</item>
    </style>

    <!-- Primary action: a pill filled with the active brand gradient. backgroundTint=@null lets
         MaterialButton use the custom gradient background; the foreground keeps a ripple. -->
    <style name="Widget.App.Button.Gradient" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_brand_gradient</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <!-- Secondary action: translucent glass pill with a hairline outline. -->
    <style name="Widget.App.Button.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorSecondary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Kept for layouts that reference it; now the glass look. -->
    <style name="Widget.App.Button.Tonal" parent="Widget.App.Button.Glass" />

    <!-- Glass card: translucent fill over the canvas glow, hairline stroke, big corners. -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="TextAppearance.App.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.App.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Gradient themes (Settings > Theme), one per AppSettings.AccentColor. -->
    <style name="ThemeOverlay.Accent.Aurora" parent="">
        <item name="colorPrimary">#7C4DFF</item>
        <item name="colorSecondary">#FF4FA3</item>
        <item name="brandGlowPrimary">#407C4DFF</item>
        <item name="brandGlowSecondary">#33FF4FA3</item>
    </style>
    <style name="ThemeOverlay.Accent.Ocean" parent="">
        <item name="colorPrimary">#2F7BFF</item>
        <item name="colorSecondary">#00D2FF</item>
        <item name="brandGlowPrimary">#402F7BFF</item>
        <item name="brandGlowSecondary">#3300D2FF</item>
    </style>
    <style name="ThemeOverlay.Accent.Sunset" parent="">
        <item name="colorPrimary">#FF8A3D</item>
        <item name="colorSecondary">#FF3D7F</item>
        <item name="brandGlowPrimary">#40FF8A3D</item>
        <item name="brandGlowSecondary">#33FF3D7F</item>
    </style>
    <style name="ThemeOverlay.Accent.Emerald" parent="">
        <item name="colorPrimary">#00C9A7</item>
        <item name="colorSecondary">#7BE36A</item>
        <item name="brandGlowPrimary">#4000C9A7</item>
        <item name="brandGlowSecondary">#337BE36A</item>
    </style>
    <style name="ThemeOverlay.Accent.Neon" parent="">
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorSecondary">#B44DFF</item>
        <item name="brandGlowPrimary">#4000E5FF</item>
        <item name="brandGlowSecondary">#33B44DFF</item>
    </style>
    <style name="ThemeOverlay.Accent.Ember" parent="">
        <item name="colorPrimary">#FF4D4D</item>
        <item name="colorSecondary">#FFB03B</item>
        <item name="brandGlowPrimary">#40FF4D4D</item>
        <item name="brandGlowSecondary">#33FFB03B</item>
    </style>
</resources>
